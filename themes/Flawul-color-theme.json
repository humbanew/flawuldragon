	"tokenColors": [

		{ 
			"scope": [
				"comment",
			], 
			"settings": { 
				"foreground": "#efae79", 
				"fontStyle": "bold italic" 
			} 
		},

		{
			"scope": [
				"constant",
			],
			"settings": {
				"foreground": "#c3979b",
				"fontStyle": "bold"
