	"tokenColors": [
		{
			"settings": {
				"foreground": "#C5C8C6"
			}
		},
		{
			"scope": [
				"meta.embedded",
				"source.groovy.embedded",
				"variable.legacy.builtin.python"
			],
			"settings": {
				"foreground": "#C5C8C6"
			}
		},
		{
			"name": "Comment",
			"scope": "comment",
			"settings": {
				"fontStyle": "",
				"foreground": "#9A9B99"
			}
		},
		{
			"name": "String",
			"scope": "string",
			"settings": {
				"fontStyle": "",
				"foreground": "#9AA83A"
			}
		},
		{
			"name": "String Embedded Source",
