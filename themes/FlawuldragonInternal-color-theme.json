	"tokenColors": [
		{
			// editado↴
			"name": "Comment",
			"scope": "comment",
			"settings": {
				"foreground": "#e5c69f",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Comment Multiline",
			"scope": "comment.block",
			"settings": {
				"foreground": "#813a38",
				"fontStyle": "italic"
			}
		},
		{
			// editado↴
			"name": "String",
			"scope": "string.quoted.double",
			"settings": {
				"foreground": "#fbffdd"
			}
		},
		{
			// editado↴
			"name": "String",
			"scope": "string.quoted.single",
			"settings": {
				"foreground": "#7ae1ef"
			}
		},
		{
			// editado↴
			"name": "Number",
			"scope": "constant.numeric, variable.other.constant, constant.character, constant.escape, constant.other, constant.regexp, entity.name.constant, keyword.other.unit",
			"settings": {
				"foreground": "#6d5d6e",
				"fontStyle": "bold"
			}
		},
		{
			// editado↴
			"name": "Variable",
			"scope": "variable.language, variable.other",
			"settings": {
				"foreground": "#4b38d0"
			}
		},
		{
			// editado↴
			"name": "Keyword",
			"scope": "keyword",
			"settings": {
				"foreground": "#3e2a7b",
				"fontStyle": " bold"
			}
		},
		{
			// editado↴
			"name": "Storage",
			"scope": "storage",
			"settings": {
				"foreground": "#4a71f5",
				"fontStyle": "bold italic"
			}
		},
		{
			// editado↴
			"name": "Class name",
			"scope": "entity.name.class, entity.name.type.class",
			"settings": {
				"foreground": "#e5c69f"
			}
		},
		{
			// editado↴
			"name": "Function name",
			"scope": "entity.name.function",
			"settings": {
				"foreground": "#b08360"
			}
		},
		{
			// vizualizado↴
			"name": "Variable start",
			"scope": "punctuation.definition.variable",
			"settings": {
				"foreground": "#00000000"
			}
		},
		{
			// vizualizado↴
			"name": "Embedded code markers",
			"scope": "punctuation.section.embedded.begin, punctuation.section.embedded.end",
			"settings": {
				"foreground": "#54814eff"
			}
		},
		{
			// adicionado↴
			"name": "Keywords - New",
			"scope": "keyword.operator.new, keyword.operator.delete, keyword.operator.typeof, keyword.operator.in, keyword.operator.instanceof, keyword.operator.sizeof",
			"settings": {
				"foreground": "#ffce4a",
				"fontStyle": "italic bold"
			}
		},
