{
  "compilerOptions": {
    "module": "ESNext",
    "target": "es2020",
    "outDir": "./out",
    "lib": ["es2020"],
    "sourceMap": false,
    "rootDir": "./src",
    "moduleResolution": "node",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": false,
    "strict": true
  },
  "exclude": ["node_modules", "out", "triagem", "src/old"]
}
