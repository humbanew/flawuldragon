{
  "compilerOptions": {
    "module": "ES2020",
    "target": "ESNext",
    "outDir": "./out",
    "lib": ["es2020"],
    "sourceMap": false,
    "declaration": false,
    "declarationMap": false,
    "rootDir": "./src",
    "moduleResolution": "node",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "allowJs": true,
    "checkJs": false,
    "strictNullChecks": false,
    "strict": true,
  },
  "exclude": ["node_modules", "out", "flawuldragon-devkit", "integration"]
}
