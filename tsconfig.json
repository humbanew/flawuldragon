{
  "compilerOptions": {
    "module": "es2020",
    "target": "esnext",
    "outDir": "./out",
    "lib": ["es2020"],
    "sourceMap": false,
    "rootDir": "./src",
    "moduleResolution": "node",
    "moduleDetection": "auto",
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "strict": true
  },
  "exclude": ["node_modules", ".vscode-test", "scripts", "out"]
}
