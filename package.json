{
  "name": "flawuldragon",
  "displayName": "Flawuldragon",
  "description": "Humbanew Official Development Extension",
  "version": "1.0.0",
  "icon": "assets/icon.png",
  "readme": "README.md",
  "license": "Humbanew License v5, powered by MIT License",
  "repository": {
    "type": "git",
    "url": "https://github.com/humbanew/flawuldragon"
  },
  "maintainers": [
    {
      "name": "Humba01",
      "email": "development@humbanew.com.br",
      "url": "https://www.humbanew.com.br"
    }
  ],
  "galleryBanner": {
    "color": "#451aff",
    "theme": "dark"
  },
  "publishConfig": {
    "access": "public"
  },
  "publisher": "humbanew",
  "scripts": {
    "vsc-package": "npx vsce package",
    "vsc-publish": "npx vsce publish",
    "vsc-help": "npx vsce help",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./dist/test/runTest.js"
  },
  "main": "./dist/extension.js",
  "browser": "./dist/extension-web.js",
  "engines": {
    "vscode": ">=1.80.0",
    "node": ">=20.0.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onTaskType:node",
    "onTaskType:npm"
  ],
