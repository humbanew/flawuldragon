{
  "name": "hn.flawuldragon-developer-theme",
  "displayName": "Flawuldragon",
  "description": "Humbanew Official Theme",
  "version": "0.0.1",
  "icon": "assets/icon.png",
  "readme": "README.md",
  "license": "Humbanew License v5",
  "repository": {
    "type": "git",
    "url": "https://github.com/humbanew/flawuldragon"
  },
  "galleryBanner": {
    "color": "#ff3335",
    "theme": "dark"
  },
  "publishConfig": {
    "access": "public"
  },
  "publisher": "humbanew",
  "scripts": {
    "vscode:prepublish": "yarn run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "yarn run compile && yarn run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js",
    "prebuild": "tsx ./scripts/build/build.ts",
    "package": "vsce package"
  },
  "engines": {
    "vscode": "^1.83.1",
    "node": "^22.0.0"
  },
  "bundleDependencies": [
    "vscode"
  ],
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "categories": [
    "Extension Packs",
    "Formatters",
    "Themes",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onTaskType:node",
    "onTaskType:npm"
  ],
  "main": "./out/extension.cjs",
  "contributes": {
    "themes": [
      {
        "id": "flawuldragon-blueprint-paper-theme",
        "label": "Flawuldragon - Blueprint Paper",
        "uiTheme": "vs-dark",
        "path": "./themes/blueprint_paper-color-theme.json"
      },
      {
        "id": "flawuldragon-los-angeles-summer-theme",
        "label": "Flawuldragon - Los Angeles Summer",
        "uiTheme": "vs-dark",
        "path": "./themes/los_angeles_summer-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "flawuldragon-jetbrains-icon-theme",
        "label": "Flawuldragon - JIT v1 Dark",
        "path": "./dist/v1/dark/theme.json"
      },
      {
        "id": "flawuldragon-jetbrains-icon-theme-2023-light",
        "label": "Flawuldragon - JIT 2023+ UI Light",
        "path": "./dist/2023/light/theme.json"
      },
      {
        "id": "flawuldragon-jetbrains-icon-theme-2023-dark",
        "label": "Flawuldragon - JIT 2023+ UI Dark",
        "path": "./dist/2023/dark/theme.json"
      },
      {
        "id": "flawuldragon-jetbrains-icon-theme-2023-auto",
        "label": "Flawuldragon - JIT 2023+ UI Auto",
        "path": "./dist/2023/auto/theme.json"
      }
    ],
    "commands": [
      {
        "command": "flawuldragon_jetbrainsmonofont.activate",
        "title": "Activate JetBrains Mono Font Pack for Flawuldragon"
      },
      {
        "command": "flawuldragon_jetbrainsmonofont.deactivate",
        "title": "Deactivate JetBrains Mono Font for Flawuldragon"
      }
    ]
  },
  "keywords": [
    "Flawuldragon",
    "Humbanew",
    "Theme",
    "Color Theme",
    "Icon Theme",
    "Font Pack",
    "JetBrains Mono",
    "Blueprint Paper",
    "Los Angeles Summer",
    "Official"
  ],
  "devDependencies": {
    "@types/follow-redirects": "^1.13.0",
    "@types/glob": "^8.0.0",
    "@types/mocha": "^10.0.0",
    "@types/node": "^20.8.0",
    "@types/vscode": "^1.72.0",
    "@typescript-eslint/eslint-plugin": "^5.38.1",
    "@typescript-eslint/parser": "^5.38.1",
    "@vscode/test-electron": "^2.1.5",
    "eslint": "^8.24.0",
    "follow-redirects": "^1.13.3",
    "fs": "^0.0.1-security",
    "glob": "^8.0.3",
    "inly": "^4.0.8",
    "mocha": "^10.0.0",
    "path": "^0.12.7",
    "typescript": "^5.2.2",
    "vscode-test": "^1.5.0",
    "@actions/core": "^1.10.1",
    "@vscode/vsce": "^2.19.0",
    "semantic-release": "^21.0.6",
    "semantic-release-vsce": "^5.5.10",
    "svgson": "^5.3.1",
    "tsx": "^3.13.0"
  }
}
