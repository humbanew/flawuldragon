      {
        "id": "fd-jetbrains-icon-classic",
        "label": "Flawuldragon - JIT v1 Dark",
        "path": "./out/icons/v1/dark/theme.json"
      },
      {
        "id": "fd-jetbrains-icon-theme-2023-light",
        "label": "Flawuldragon - JIT 2023+ UI Light",
        "path": "./out/icons/2023/light/theme.json"
      },
      {
        "id": "fd-jetbrains-icon-theme-2023-dark",
        "label": "Flawuldragon - JIT 2023+ UI Dark",
