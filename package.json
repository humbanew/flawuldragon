{
  "name": "hn.flawuldragon",
  "displayName": "Flawuldragon",
  "description": "Humbanew Official Development Extension",
  "version": "1.0.0",
  "icon": "assets/icon.png",
  "readme": "README.md",
  "license": "Humbanew License v5, powered by MIT License",
  "repository": {
    "type": "git",
    "url": "https://github.com/humbanew/flawuldragon"
  },
  "galleryBanner": {
    "color": "#451aff",
    "theme": "dark"
  },
  "publishConfig": {
    "access": "public"
  },
  "publisher": "humbanew_project",
  "scripts": {
    "fd:vscode:package": "npx vsce package",
    "fd:vscode:publish": "npx vsce publish",
    "fd:vscode:help": "npx vsce help",
    "fd:compile": "tsc -p ./",
    "fd:watch": "tsc -watch -p ./",
    "fd:pretest": "yarn run compile && yarn run lint",
    "fd:lint": "eslint src --ext ts",
    "fd:test": "node ./out/test/runTest.js"
  },
  "main": "./out/extension.cjs",
  "engines": {
    "vscode": "^1.80.0",
    "node": "^22.0.0"
  },
  "extensionKind": [
    "ui",
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "categories": [
    "Extension Packs",
    "Formatters",
    "Themes",
    "Programming Languages",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onTaskType:node",
    "onTaskType:npm"
  ],
