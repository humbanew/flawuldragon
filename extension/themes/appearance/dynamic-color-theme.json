    {
      "scope": "support",
      "settings": {
        "foreground": "#84a0c6"
      }
    },
    {
      "scope": "support.type.property-name",
      "settings": {
        "foreground": "#84a0c6"
      }
    },
    {
      "scope": "variable.language.this",
      "settings": {
        "foreground": "#b4be82"
      }
    },
    {
      "scope": "text",
      "settings": {
        "foreground": "#c6c8d1"
      }
    },
    {
      "scope": "meta.diff.header",
      "settings": {
        "foreground": "#84a0c6"
